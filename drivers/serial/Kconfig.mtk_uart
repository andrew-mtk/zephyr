config UART_MT8365
	bool "MediaTek MT8365 UART driver"
	default y
	depends on SOC_MT8365
	depends on DT_HAS_MEDIATEK_MT8365_UART_ENABLED
	select PINCTRL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	help
	  Enable the MediaTek MT8365 UART driver.

config UART_MT8188
	bool "MediaTek MT8188 UART driver"
	default y
	depends on SOC_MT8188_A55
	depends on DT_HAS_MEDIATEK_MT8188_UART_ENABLED
	select PINCTRL
	select SERIAL_HAS_DRIVER
	select SERIAL_SUPPORT_INTERRUPT
	help
	  Enable the MediaTek MT8188 UART driver.
