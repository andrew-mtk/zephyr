config SOC_MT8188
	bool
	select SOC_SERIES_MT818X

config SOC_MT8188_ADSP
	bool
	select SOC_MT8188
	select SOC_MTK_ADSP_CLUSTER
	help
	  MediaTek MT8188 audio DSP

config SOC_MT8188_A55
	bool
	select SOC_MT8188
	select SOC_MTK_ARM_CLUSTER
	help
	  MediaTek MT8188 Cortex-A55 cluster

config SOC
	default "mt8188" if SOC_MT8188

config SOC_MTK_CLUSTER_SUBDIR
	default "a55" if SOC_MT8188_A55
