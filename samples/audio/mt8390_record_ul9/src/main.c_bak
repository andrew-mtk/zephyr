 *
 * MT8390 capture sample: UL9 ← CM0 (bypass) ← AFE_CONN ← eTDM_IN1 + eTDM_IN2,
 * 32 channel, 48 kHz, 32-bit. eTDM_IN1/IN2 run in co-clock (cowork) mode.
 * Prints one sample per channel per second.
 */

#include <zephyr/device.h>
#include <zephyr/kernel.h>
#include <zephyr/linker/devicetree_regions.h>
#include <zephyr/sys/printk.h>

#include "mt8390-afe.h"

#define SAMPLE_RATE     48000
#define CHANNELS        4	/* 4 channels */
#define WORD_BYTES      4   /* 32-bit */
#define BUF_MS          1000

#define BUF_FRAMES      (SAMPLE_RATE * BUF_MS / 1000)
#define BUF_SAMPLES     (BUF_FRAMES * CHANNELS)
#define BUF_BYTES       (BUF_SAMPLES * WORD_BYTES)

/* DMA buffer lives in the dedicated dma_region (see board DTS), outside
 * zephyr,sram, so AFE DMA cannot reach the Zephyr image, stack or heap.
 */
static int32_t dma_buf[BUF_SAMPLES]
	Z_GENERIC_SECTION(LINKER_DT_NODE_REGION_NAME(DT_NODELABEL(dma_region)))
	__aligned(64);

int main(void)
{
	const struct device *dev;
	const struct mt8390_afe_driver_api *api;
	struct mt8390_afe_cfg cfg = {
		.rate          = SAMPLE_RATE,
		.channels      = CHANNELS,
		.word_size     = 32,
		.fmt           = MT8390_ETDM_FMT_DSPB,
		.data_mode     = MT8390_ETDM_DATA_ONE_PIN,
		.mclk_freq     = 256 * SAMPLE_RATE,   /* 12.288 MHz for 48 kHz * 256 */
		.mclk_dir      = MT8390_MCLK_DIR_OUT,
		.period_frames = SAMPLE_RATE / 100, /* 10 ms period */
	};
	int ret;
	printk("DMA buffer at virt %p\n", dma_buf);

	for (size_t i = 0; i < BUF_SAMPLES; i++) {
		dma_buf[i] = 0xdea00000 + i * WORD_BYTES; /* dummy data for testing */
	}
	printk("dma_buf[0] = 0x%08x, dma_buf[%d] = 0x%08x\n", dma_buf[0], BUF_SAMPLES - 1, dma_buf[BUF_SAMPLES - 1]);

	dev = DEVICE_DT_GET(DT_NODELABEL(afe));
	if (!device_is_ready(dev)) {
		printk("AFE device not ready\n");
		return -ENODEV;
	}
	api = dev->api;

	ret = api->configure(dev, MT8390_UL9, &cfg);
	if (ret) {
		printk("configure failed: %d\n", ret);
		return ret;
	}

	/* Route eTDM_IN1+IN2 → UL9; driver configures cowork internally */
	ret = api->route(dev, MT8390_ROUTE_SRC_ETDM_IN1_IN2, MT8390_ROUTE_DST_UL9);
	if (ret) {
		printk("route failed: %d\n", ret);
		return ret;
	}

	/* Single CPU-address -> hardware-address conversion point: a non-flat
	 * mapping would only need changing here.
	 *
	 * dma_region is flat-mapped (VA == PA, see soc/mediatek/mt8390/a55/
	 * mmu_regions.c), so the linker address already IS the physical address
	 * the AFE needs. k_mem_phys_addr() is deliberately not used: its range
	 * assert only covers the kernel VM window (CONFIG_KERNEL_VM_BASE/SIZE),
	 * which excludes this region.
	 */
	const uint32_t dma_buf_pa = (uint32_t)(uintptr_t)dma_buf;

	ret = api->set_buf(dev, MT8390_UL9, dma_buf_pa, BUF_BYTES);
	if (ret) {
		printk("set_buf failed: %d\n", ret);
		return ret;
	}

	ret = api->start(dev, MT8390_UL9);
	if (ret) {
		printk("start failed: %d\n", ret);
		return ret;
	}

	printk("MT8390 UL9 capture started: 48kHz 32ch 32-bit via CM0 cowork\n");

	while (1) {
		k_msleep(1000);

		/* get_cur returns a physical address */
		uint32_t ptr = api->get_cur(dev, MT8390_UL9);
		uint32_t offset = (ptr > dma_buf_pa) ? (ptr - dma_buf_pa) : 0;
		uint32_t frame = offset / (CHANNELS * sizeof(dma_buf[0]));
		uint32_t sample_idx = (frame > 0 ? frame - 1 : 0) * CHANNELS;

		printk("UL9 offset: 0x%08x frame: %d\n", offset, frame);

		for (int ch = 0; ch < CHANNELS; ch++) {
			printk("ch%02d: 0x%08x  ", ch, (uint32_t)dma_buf[sample_idx + ch]);
			if (ch % 4 == 3)
				printk("\n");
		}
		printk("\n");
	}

	return 0;
}
